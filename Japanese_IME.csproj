<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>JapaneseIME</AssemblyName>
    <RootNamespace>JapaneseIME</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="manifest.json"/>
  </ItemGroup>
  <ItemGroup>
    <!-- The helper is a separate process; it must not be compiled into the plugin. -->
    <Compile Remove="KanjiHost\**" />
    <None Remove="KanjiHost\**" />
  </ItemGroup>
  <!--
    Microsoft IME conversion runs in a native DLL when it can be built, and in a
    helper process otherwise. Both are added to the BSMT outputs so they ship next
    to the plugin DLL.
  -->
  <Target Name="JapaneseIME_BuildNative" BeforeTargets="JapaneseIME_BuildKanjiHost">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Native\build.ps1&quot; -OutputDir &quot;$(MSBuildProjectDirectory)\bin\$(Configuration)&quot; -Configuration $(Configuration) -Platform x64"
          ContinueOnError="true" />
  </Target>
  <Target Name="JapaneseIME_BuildKanjiHost"
          BeforeTargets="CopyToArtifactDestination;BSMT_CopyToPlugins;BSMT_ZipRelease">
    <MSBuild Projects="KanjiHost\JapaneseIME.KanjiHost.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <OutputCopy Include="$(TargetDir)$(AssemblyName).dll" OutputPath="Plugins\$(AssemblyName).dll" />
      <OutputCopy Include="$(TargetDir)$(AssemblyName).pdb" OutputPath="Plugins\$(AssemblyName).pdb"
                  Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <OutputCopy Include="KanjiHost\bin\$(Configuration)\JapaneseIME.KanjiHost.exe"
                  OutputPath="Plugins\JapaneseIME.KanjiHost.exe" />
      <OutputCopy Include="bin\$(Configuration)\JapaneseIME.KanjiNative.dll"
                  OutputPath="Libs\Natives\JapaneseIME.KanjiNative.dll"
                  Condition="Exists('$(MSBuildProjectDirectory)\bin\$(Configuration)\JapaneseIME.KanjiNative.dll')" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="IPA.Loader">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\IPA.Loader.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Main">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Main.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="HMLib">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMLib.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="HMUI">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMUI.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll</HintPath>
